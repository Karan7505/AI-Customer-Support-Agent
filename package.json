{
  "name": "ai-customer-support-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic AI customer support system with tool calling, deterministic permissions, human-in-the-loop approvals, idempotent refunds, audit logging, and a full test/evaluation suite.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/migrate.ts --reset && tsx src/db/seed.ts",
    "eval": "vitest run tests/eval"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "0.38.2",
    "lucide-react": "0.469.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "20.17.10",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.30.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.6",
    "jsdom": "26.0.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
