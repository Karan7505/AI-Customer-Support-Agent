# ---------------------------------------------------------------------------
# AI Customer Support Agent - environment configuration
# Copy to .env.local for local development:  cp .env.example .env.local
# NEVER commit real values. Placeholders only.
#
# The app is API-key-CONFIGURABLE and production-oriented:
#   - Leave every secret EMPTY -> it runs fully offline (mock LLM + SQLite).
#   - Add OPENAI_API_KEY and/or DATABASE_URL -> it AUTOMATICALLY switches to
#     real OpenAI (or compatible) and Supabase/Postgres. No code change needed.
# The active mode is printed to the server log at startup.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# Optional. AUTO by default: empty OPENAI_API_KEY -> deterministic mock planner;
# a non-empty OPENAI_API_KEY -> OpenAI-compatible function calling.
# You can also force a mode explicitly: LLM_PROVIDER=mock  |  openai
LLM_PROVIDER=

# Required ONLY when using the real LLM (i.e. when OPENAI_API_KEY is set).
# Any OpenAI-compatible base URL works (OpenRouter, vLLM, etc.).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Maximum agent reasoning iterations per user message (infinite-loop guard).
AGENT_MAX_ITERATIONS=6

# --- Database --------------------------------------------------------------
# AUTO by default: empty DATABASE_URL -> local SQLite at DATABASE_PATH.
# Set the Supabase/Postgres connection string to use it instead.
# (Supabase console: Project Settings -> Database -> Connection string —
#  it is a postgresql:// URL with your project's host, user and password.)
DATABASE_URL=
# Local SQLite file (used only when DATABASE_URL is empty).
DATABASE_PATH=./data/app.db

# --- App -------------------------------------------------------------------
# Public base URL (used in audit/notifications where applicable).
APP_URL=http://localhost:3000

# Secret used to HMAC-sign session cookies. REQUIRED in production: the app
# refuses to start without it. Use a long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string

# How long a pending approval request stays actionable (hours).
APPROVAL_TTL_HOURS=72

# --- Rate limits -------------------------------------------------------------
# Per-customer chat cap (LLM spend guard): at most CHAT_TURNS_PER_WINDOW chat
# turns per CHAT_WINDOW_MS, then HTTP 429. Login is fixed: 8 / 10 min per IP
# and per account.
CHAT_TURNS_PER_WINDOW=60
CHAT_WINDOW_MS=600000

# --- Observability (blueprint section 10) ------------------------------------
# Structured logging. LOG_LEVEL: error | warn | info | debug (default info).
# LOG_FORMAT: json | pretty (default json in production, pretty in dev).
# JSON logs carry a `corr` field (correlation id); incoming X-Request-Id
# headers are honored and echoed back on API responses.
LOG_LEVEL=
LOG_FORMAT=

# Prometheus metrics on a localhost-only port (internal-only by design).
# METRICS_ENABLED=true serves /metrics on METRICS_PORT (127.0.0.1).
METRICS_ENABLED=true
METRICS_PORT=9090

# Readiness probe cache TTL for GET /health/ready (ms). 0 disables caching.
HEALTH_CHECK_INTERVAL_MS=30000

# Optional integrations probed by /health/ready (degraded, never blocking):
# REDIS_URL=redis://localhost:6379
# STRIPE_SECRET_KEY=sk_test_...
