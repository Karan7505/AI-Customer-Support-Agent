# ---------------------------------------------------------------------------
# AI Customer Support Agent - environment configuration
# Copy to .env.local for local development:  cp .env.example .env.local
# NEVER commit real values. The app runs fully offline with defaults.
# ---------------------------------------------------------------------------

# --- LLM provider ----------------------------------------------------------
# "mock"   -> deterministic intent router (default; no key needed; used by
#             tests and E2E so the agent loop is reproducible).
# "openai" -> real OpenAI-compatible function calling.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=openai. Any OpenAI-compatible base URL works
# (OpenRouter, vLLM, etc.). Never commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Maximum agent reasoning iterations per user message (infinite-loop guard).
AGENT_MAX_ITERATIONS=6

# --- Database ---------------------------------------------------------------
# SQLite file used by the mock business backend (default: ./data/app.db).
# Set an absolute/relative path. Tests use an in-memory database automatically.
DATABASE_PATH=./data/app.db

# --- App --------------------------------------------------------------------
# Public base URL (used in audit/notifications where applicable).
APP_URL=http://localhost:3000

# Secret used to HMAC-sign session cookies. Use a long random string in prod.
SESSION_SECRET=change-me-to-a-long-random-string

# How long a pending approval request stays actionable (hours).
APPROVAL_TTL_HOURS=72
