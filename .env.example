# ---------------------------------------------------------------------------
# AI Customer Support Agent - environment configuration
# Copy to .env.local for local development:  cp .env.example .env.local
# NEVER commit real values. Placeholders only.
#
# The app is API-key-CONFIGURABLE and production-oriented:
#   - Leave every secret EMPTY -> it runs fully offline (mock LLM + SQLite).
#   - Add OPENAI_API_KEY and/or DATABASE_URL -> it AUTOMATICALLY switches to
#     real OpenAI (or compatible) and Supabase/Postgres. No code change needed.
# The active mode is printed to the server log at startup.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# Optional. AUTO by default: empty OPENAI_API_KEY -> deterministic mock planner;
# a non-empty OPENAI_API_KEY -> OpenAI-compatible function calling.
# You can also force a mode explicitly: LLM_PROVIDER=mock  |  openai
LLM_PROVIDER=

# Required ONLY when using the real LLM (i.e. when OPENAI_API_KEY is set).
# Any OpenAI-compatible base URL works (OpenRouter, vLLM, etc.).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Maximum agent reasoning iterations per user message (infinite-loop guard).
AGENT_MAX_ITERATIONS=6

# --- Database --------------------------------------------------------------
# AUTO by default: empty DATABASE_URL -> local SQLite at DATABASE_PATH.
# Set the Supabase/Postgres connection string to use it instead.
# (Supabase console: Project Settings -> Database -> Connection string —
#  it is a postgresql:// URL with your project's host, user and password.)
DATABASE_URL=
# Local SQLite file (used only when DATABASE_URL is empty).
DATABASE_PATH=./data/app.db

# --- App -------------------------------------------------------------------
# Public base URL (used in audit/notifications where applicable).
APP_URL=http://localhost:3000

# Secret used to HMAC-sign session cookies. REQUIRED in production: the app
# refuses to start without it. Use a long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string

# How long a pending approval request stays actionable (hours).
APPROVAL_TTL_HOURS=72

# --- Rate limits (blueprint §7.6) ---------------------------------------------
# Per-customer sustained chat cap: at most RATE_LIMIT_MSG_PER_HOUR messages per
# hour, then HTTP 429 (code RATE_LIMITED). CHAT_TURNS_PER_WINDOW stays as a
# short-window spike cap on top. Login is fixed: 8 / 10 min per IP/account.
RATE_LIMIT_MSG_PER_HOUR=20
# New refund requests per customer per day (429 code RATE_LIMITED on exceed).
RATE_LIMIT_REFUND_PER_DAY=5
# API calls per IP per minute across all /api routes, then HTTP 429.
RATE_LIMIT_API_PER_MIN=100
# memory (in-process Map, default) | redis (documented extension point).
RATE_LIMIT_PROVIDER=memory
# Cumulative LLM spend per customer per day in CENTS; 429 above the cap.
LLM_DAILY_COST_CENTS=5000
CHAT_TURNS_PER_WINDOW=60
CHAT_WINDOW_MS=600000

# --- Provider reliability (blueprint §8) ----------------------------------------
# Timeout per provider HTTP call (Stripe, EasyPost).
PROVIDER_TIMEOUT_MS=10000
# Retries on TRANSIENT failures only (408/429/5xx/timeout/network); 4xx fails fast.
# Backoff is exponential: base, base*2, base*4 (default 1s -> 2s -> 4s).
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BACKOFF_MS=1000

# --- Data lifecycle (blueprint §6.6) ----------------------------------------------
# Weekly retention sweep: customers soft-deleted after N years,
# orders/tickets/conversations/messages after 2 years, audit logs hard-deleted
# after N years. Refunds are retained forever (financial records).
DATA_RETENTION_CUSTOMER_YEARS=1
DATA_RETENTION_AUDIT_YEARS=3
# Reserved for the future cold-storage archiving path (no-op today).
DATA_RETENTION_ARCHIVE_ENABLED=true

# --- Observability (blueprint section 10) ------------------------------------
# Structured logging. LOG_LEVEL: error | warn | info | debug (default info).
# LOG_FORMAT: json | pretty (default json in production, pretty in dev).
# JSON logs carry a `corr` field (correlation id); incoming X-Request-Id
# headers are honored and echoed back on API responses.
LOG_LEVEL=
LOG_FORMAT=

# Prometheus metrics on a localhost-only port (internal-only by design).
# METRICS_ENABLED=true serves /metrics on METRICS_PORT (127.0.0.1).
METRICS_ENABLED=true
METRICS_PORT=9090

# Readiness probe cache TTL for GET /health/ready (ms). 0 disables caching.
HEALTH_CHECK_INTERVAL_MS=30000

# Optional integrations probed by /health/ready (degraded, never blocking):
# REDIS_URL=redis://localhost:6379
# STRIPE_SECRET_KEY=sk_test_...

# --- LLM hardening (blueprint section 5.1) -----------------------------------
# Per-call timeout for the OpenAI provider (retries happen within this window).
LLM_TIMEOUT_MS=30000
# Per-turn cost guardrail in CENTS; the turn stops above it.
LLM_MAX_COST_CENTS=100

# --- Identity & sessions (blueprint section 7.1 / 7.4) -------------------------
# Public self-service registration (POST /api/auth/register).
REGISTRATION_ENABLED=true
# New accounts must verify their email before login (24h single-use link).
EMAIL_VERIFICATION_REQUIRED=true
PASSWORD_MIN_LENGTH=8
# Absolute session lifetime in ms (default 7 days).
SESSION_EXPIRES_MS=604800000
# EMAIL_VERIFICATION_TTL_MS=86400000
# PASSWORD_RESET_TTL_MS=3600000
# SESSION_SECRET (above) is REQUIRED in production; outside production a dev
# constant is used. Password change / reset rotate ALL of the user's sessions.

# --- Carrier tracking (blueprint section 5.3) ---------------------------------
# TRACKING_PROVIDER: mock | easypost. Auto: easypost when EASYPOST_API_KEY set.
TRACKING_PROVIDER=
# EASYPOST_API_KEY=
# EASYPOST_API_BASE=https://api.easypost.com

# --- Stripe refunds (blueprint section 5.4) -----------------------------------
# With a key, refunds on orders carrying a real stripe_payment_intent_id are
# pushed to Stripe (idempotent). Orders seeded with pi_mock_* ids skip the
# provider entirely. Provider failures queue a background retry and the refund
# shows "Awaiting provider" until settled.
# STRIPE_SECRET_KEY=
# STRIPE_API_BASE=https://api.stripe.com/v1

# --- Email notifications (blueprint section 5.5) ------------------------------
# Via Resend; no-ops (debug log) without a key. All delivery goes through the
# job queue with retries; existing audit entries are unchanged.
NOTIFICATIONS_ENABLED=true
# RESEND_API_KEY=
# RESEND_API_BASE=https://api.resend.com
NOTIFICATIONS_FROM=Aurora Support <noreply@aurora-support.local>
# approval_requested -> ADMIN_EMAIL_LIST ; ticket_updated -> customer + SUPPORT_TEAM_EMAIL_LIST
# ADMIN_EMAIL_LIST=
# SUPPORT_TEAM_EMAIL_LIST=

# --- Background job queue (blueprint section 5.6) -----------------------------
# memory (default, in-process) | redis (documented extension point, see README)
QUEUE_PROVIDER=memory
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_MS=1000
