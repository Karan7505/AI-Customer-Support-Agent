# ---------------------------------------------------------------------------
# AI Customer Support Agent - environment configuration
# Copy to .env.local for local development:  cp .env.example .env.local
# NEVER commit real values. Placeholders only.
#
# The app is API-key-CONFIGURABLE and production-oriented:
#   - Leave every secret EMPTY -> it runs fully offline (mock LLM + SQLite).
#   - Add OPENAI_API_KEY and/or DATABASE_URL -> it AUTOMATICALLY switches to
#     real OpenAI (or compatible) and Supabase/Postgres. No code change needed.
# The active mode is printed to the server log at startup.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# Optional. AUTO by default: empty OPENAI_API_KEY -> deterministic mock planner;
# a non-empty OPENAI_API_KEY -> OpenAI-compatible function calling.
# You can also force a mode explicitly: LLM_PROVIDER=mock  |  openai
LLM_PROVIDER=

# Required ONLY when using the real LLM (i.e. when OPENAI_API_KEY is set).
# Any OpenAI-compatible base URL works (OpenRouter, vLLM, etc.).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Maximum agent reasoning iterations per user message (infinite-loop guard).
AGENT_MAX_ITERATIONS=6

# --- Database --------------------------------------------------------------
# AUTO by default: empty DATABASE_URL -> local SQLite at DATABASE_PATH.
# Set the Supabase/Postgres connection string to use it instead, e.g.
#   Supabase:  postgresql://postgres.<ref>:<password>@aws-<region>.rds.<region>.amazonaws.com:5432/postgres
# (In the Supabase console: Project Settings -> Database -> Connection string.)
DATABASE_URL=
# Local SQLite file (used only when DATABASE_URL is empty).
DATABASE_PATH=./data/app.db

# --- App -------------------------------------------------------------------
# Public base URL (used in audit/notifications where applicable).
APP_URL=http://localhost:3000

# Secret used to HMAC-sign session cookies. Use a long random string in prod.
SESSION_SECRET=change-me-to-a-long-random-string

# How long a pending approval request stays actionable (hours).
APPROVAL_TTL_HOURS=72
